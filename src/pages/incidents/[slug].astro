---
import Base from '../../layouts/Base.astro';
import { loadIncidents } from '../../lib/vault';

export function getStaticPaths() {
  return loadIncidents().map((incident) => ({
    params: { slug: incident.slug },
    props: { incident },
  }));
}

const { incident } = Astro.props;
---

<Base title={`${incident.title} · failforward.dev`} description={incident.summary}>
  <article class="article">
    <div class="meta-row">
      <span class={`badge ${incident.severity}`}>{incident.severity.toUpperCase()}</span>
      <span class="badge cat">{incident.category}</span>
      <span>{incident.date.toISOString().slice(0, 10)}</span>
    </div>
    <h1>{incident.title}</h1>
    <p style="color: var(--text-dim);">{incident.summary}</p>
    <div class="content" set:html={incident.html} />
    <p style="margin-top: 3rem;"><a href="/incidents/">← all incidents</a></p>
  </article>
</Base>
