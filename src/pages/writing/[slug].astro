---
import Base from '../../layouts/Base.astro';
import { marked } from 'marked';
import data from '../../data/writing.json';

export function getStaticPaths() {
  return data.series.flatMap((s) =>
    s.posts
      .filter((po) => po.body && po.body.trim().length > 0)
      .map((po) => ({ params: { slug: po.slug }, props: { post: po, series: s } }))
  );
}

const { post, series } = Astro.props;
const html = marked.parse(post.body, { async: false });
const external = (post as { url?: string }).url || data.linkedin;
---

<Base title={`${post.title} · failforward.dev`} description={post.hook}>
  <article class="article">
    <div class="meta-row">
      <span class="section-tag">SERIES {series.number} · {String(post.n).padStart(2, '0')}</span>
      {post.live ? <span class="badge lesson">LIVE</span> : <span class="badge cat">DRAFT</span>}
      {(post as { date?: string }).date && <span>{(post as { date?: string }).date}</span>}
    </div>
    <h1>{post.title}</h1>
    <p class="muted">{post.hook}</p>
    <div class="content" set:html={html} />
    {post.live && (
      <p class="muted" style="margin-top: 2rem;">
        Also published on <a href={external} target="_blank" rel="noopener">LinkedIn →</a>
      </p>
    )}
    <p style="margin-top: 3rem;"><a href="/writing/">← all writing</a></p>
  </article>
</Base>
