---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} · failforward.dev`} description={frontmatter.summary}>
  <article class="article" style="max-width: 52rem;">
    <div class="meta-row">
      {frontmatter.status && <span class="badge lesson">{frontmatter.status.toUpperCase()}</span>}
      {frontmatter.version && <span class="badge cat">v{frontmatter.version}</span>}
      {frontmatter.updated && <span>{frontmatter.updated}</span>}
    </div>
    <h1>{frontmatter.title}</h1>
    {frontmatter.summary && <p style="color: var(--text-dim);">{frontmatter.summary}</p>}
    <div class="content">
      <slot />
    </div>
    <p style="margin-top: 3rem;"><a href="/projects/">← all projects</a></p>
  </article>
</Base>
