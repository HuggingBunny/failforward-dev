---
import { loadIncidents } from '../../lib/vault';
const incidents = loadIncidents();
const categories = [...new Set(incidents.map((i) => i.category))];
---

<section class="hero compact">
  <span class="section-tag">FULL RECORD</span>
  <h1>Incident & Post-Mortem Gallery</h1>
  <p class="sub">
    Engineering failure modes, categorized. Every entry passed the
    <code>publish: true</code> gate from the source vault.
  </p>
  <div class="filter-row" id="filters">
    <button class="active" data-cat="all">all</button>
    {categories.map((c) => <button data-cat={c}>{c}</button>)}
  </div>
</section>

<div class="incident-grid">
  {incidents.map((i) => (
    <a class="incident-card" href={`/incidents/${i.slug}/`} data-category={i.category}>
      <div class="meta-row">
        <span class={`badge ${i.severity}`}>{i.severity.toUpperCase()}</span>
        <span class="badge cat">{i.category}</span>
        <span>{i.date.toISOString().slice(0, 10)}</span>
      </div>
      <h3>{i.title}</h3>
      <p class="summary">{i.summary}</p>
    </a>
  ))}
</div>

<script>
  document.querySelectorAll('#filters button').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#filters button').forEach((b) => b.classList.toggle('active', b === btn));
      const cat = (btn as HTMLElement).dataset.cat;
      document.querySelectorAll<HTMLElement>('.incident-card[data-category]').forEach((card) => {
        card.style.display = cat === 'all' || card.dataset.category === cat ? '' : 'none';
      });
    });
  });
</script>
