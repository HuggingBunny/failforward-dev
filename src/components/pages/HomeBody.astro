---
import LabelShowcase from '../LabelShowcase.astro';
import { loadIncidents } from '../../lib/vault';
const incidents = loadIncidents().slice(0, 3);
---

<section class="hero">
  <p class="identity"><strong>Chad Longanecker</strong> · Security Automation Engineer · AI Risk Governance</p>
  <p class="prompt section-tag">whoami</p>
  <h1>Systems fail.<br /><em>Engineers who document why don't.</em></h1>
  <p class="sub">
    15+ years securing lab environments at scale: 250+ environments, 23
    countries, DLP, incident response, M&A integration. This site is the public
    record: what broke, why, and the automation built so it never breaks the
    same way twice.
  </p>
  <div class="btn-row" id="hire">
    <a class="btn" href="/hire">hire / consult →</a>
    <a class="btn secondary" href="/incidents/">read the post-mortems →</a>
  </div>
</section>

<LabelShowcase />

<section class="showcase">
  <span class="section-tag">RECENT INCIDENTS</span>
  <h2>Post-Mortem Gallery</h2>
  <div class="incident-grid">
    {incidents.map((i) => (
      <a class="incident-card" href={`/incidents/${i.slug}/`}>
        <div class="meta-row">
          <span class={`badge ${i.severity}`}>{i.severity.toUpperCase()}</span>
          <span class="badge cat">{i.category}</span>
          <span>{i.date.toISOString().slice(0, 10)}</span>
        </div>
        <h3>{i.title}</h3>
        <p class="summary">{i.summary}</p>
      </a>
    ))}
  </div>
  <a href="/incidents/">all incidents →</a>
</section>
