---
/**
 * AI Warning Labels, interactive showcase.
 * Product selector → hazard pictograms → transparency panel (nutrition-facts
 * style) → deployment placard + certs. Interactivity is a small vanilla-JS
 * island; everything else is static HTML.
 */
import { LABELS, LABEL_SETS } from '../data/labels';

const labelById = Object.fromEntries(LABELS.map((l) => [l.id, l]));
---

<section class="showcase" id="labels">
  <header class="showcase-head">
    <span class="section-tag">FLAGSHIP</span>
    <h2>AI Warning Labels</h2>
    <p>
      A standardized hazard-communication framework for AI systems, adapted from
      GHS chemical labeling, ISO 7010 signage, and nutrition-facts panels.
      Select a product class to render its label set.
    </p>
  </header>

  <div class="product-tabs" role="tablist" aria-label="Product classes">
    {LABEL_SETS.map((set, i) => (
      <button
        class:list={['tab', { active: i === 0 }]}
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        data-set={set.id}
      >{set.product}</button>
    ))}
  </div>

  {LABEL_SETS.map((set, i) => (
    <article class:list={['label-sheet', { hidden: i !== 0 }]} data-sheet={set.id}>
      <div class="sheet-grid">
        <div class="pictograms">
          <h3 class="panel-title">HAZARD PICTOGRAMS</h3>
          <div class="picto-row">
            {set.labels.map((id) => {
              const l = labelById[id];
              return (
                <button class={`picto shape-${l.shape}`} data-label={id} title={l.name}>
                  <span class="picto-icon">{l.icon}</span>
                </button>
              );
            })}
          </div>
          <div class="picto-detail" data-detail>
            <p class="detail-hint">Select a pictogram for hazard details.</p>
          </div>
        </div>

        <div class="facts-panel">
          <h3 class="facts-title">AI Transparency Facts</h3>
          <div class="facts-divider thick"></div>
          <dl>
            <div class="fact-row"><dt>Model class</dt><dd>{set.panel.modelClass}</dd></div>
            <div class="fact-row"><dt>Training data disclosed</dt><dd class={`v-${set.panel.trainingDataDisclosed}`}>{set.panel.trainingDataDisclosed}</dd></div>
            <div class="fact-row"><dt>Eval coverage</dt><dd>{set.panel.evalCoverage}%</dd></div>
            <div class="fact-row"><dt>Human oversight</dt><dd>{set.panel.humanOversight}</dd></div>
            <div class="fact-row"><dt>Explainability</dt><dd>{set.panel.explainability}</dd></div>
            <div class="fact-row"><dt>Bias audit</dt><dd>{set.panel.biasAudit}</dd></div>
          </dl>
          <div class="facts-divider"></div>
          <div class="traffic-light" aria-label={`Overall rating: ${set.trafficLight}`}>
            <span class:list={['light', 'red', { on: set.trafficLight === 'red' }]}></span>
            <span class:list={['light', 'amber', { on: set.trafficLight === 'amber' }]}></span>
            <span class:list={['light', 'green', { on: set.trafficLight === 'green' }]}></span>
            <span class="light-caption">explainability / bias rating</span>
          </div>
        </div>

        <div class="deploy-col">
          <div class={`placard class-${set.deploymentClass}`}>
            <span class="placard-num">{set.deploymentClass}</span>
            <span class="placard-text">AI DEPLOYMENT<br />RISK CLASS</span>
          </div>
          <div class="certs">
            {set.certs.length === 0 && <span class="cert none">NO CERTIFICATIONS</span>}
            {set.certs.map((c) => <span class="cert">{c}</span>)}
          </div>
        </div>
      </div>
    </article>
  ))}
</section>

<script define:vars={{ labels: LABELS }}>
  const byId = Object.fromEntries(labels.map((l) => [l.id, l]));

  // Product tab switching
  document.querySelectorAll('.tab[data-set]').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab[data-set]').forEach((t) => {
        t.classList.toggle('active', t === tab);
        t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
      });
      document.querySelectorAll('[data-sheet]').forEach((sheet) => {
        sheet.classList.toggle('hidden', sheet.dataset.sheet !== tab.dataset.set);
      });
    });
  });

  // Pictogram detail expansion
  document.querySelectorAll('.picto[data-label]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const l = byId[btn.dataset.label];
      const sheet = btn.closest('[data-sheet]');
      sheet.querySelectorAll('.picto').forEach((p) => p.classList.toggle('selected', p === btn));
      sheet.querySelector('[data-detail]').innerHTML = `
        <div class="detail-head">
          <span class="hazard-class">${l.hazardClass}</span>
          <strong>${l.name}</strong>
        </div>
        <p class="statement">${l.statement}</p>
        <p class="precaution"><span>PRECAUTION:</span> ${l.precaution}</p>
        <p class="source">Adapted from: ${l.sourceSymbol}</p>`;
    });
  });
</script>
